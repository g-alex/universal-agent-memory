# ════════════════════════════════════════════════════════════════════
# Universal Agent Memory — configuration.
# Memory (the database) always stays yours: docker + local volume.
# Models (LLM / embeddings) point at any OpenAI-compatible endpoint:
# a cloud provider or your own server.
# After editing: docker compose up -d --force-recreate api worker
# (a plain restart does NOT re-read env!)
# ════════════════════════════════════════════════════════════════════

# --- Database and access ---
DATABASE_URL=postgresql://memory:memorypass@db:5432/memory_db
# DB password. The default is for local development only — set a strong
# one whenever the DB port is reachable beyond localhost (e.g. on a VPS).
#POSTGRES_PASSWORD=long-random-password
# Master API key (required — the service refuses to start without it).
# Seeded into api_keys on first start; clients (Cursor/bots) authenticate with it.
MASTER_API_KEY=change-me-to-long-random-string

# --- Embeddings (vector search channel) ---
# provider: ollama (self-hosted, default) | openai (cloud) | none (FTS-only search)
EMBEDDINGS_PROVIDER=ollama
EMBEDDINGS_MODEL=bge-m3
EMBEDDINGS_DIM=1024
EMBEDDINGS_BASE_URL=http://ollama:11434/v1
# Only used when EMBEDDINGS_PROVIDER=openai
OPENAI_API_KEY=
# ⚠️ Changing the embeddings MODEL (not just the URL) requires re-embedding
# or a clean database: a different dim breaks INSERT, the same dim silently
# corrupts search.

# --- LLM (dialog distillation + reflect answers) ---
# provider: openai (any OpenAI-compatible cloud API) | ollama (own server) | none
# Endpoint examples:
#   NVIDIA NIM (free tier):    https://integrate.api.nvidia.com/v1
#   Google AI Studio (Gemini): https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter:                https://openrouter.ai/api/v1
#   Own ollama server:         http://<host>:11434/v1
LLM_PROVIDER=openai
LLM_MODEL=google/gemma-4-31b-it
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-...
# LLM_PROVIDER=none — distillation off: dialogs are stored raw,
# search (vector + FTS) keeps working.

# --- Fully self-hosted option (cloud unavailable / data must not leave) ---
# ollama on your own server. bge-m3 there keeps vectors compatible
# (same model + dim → no re-embedding: point EMBEDDINGS_BASE_URL at it).
# ⚠️ ollama has no built-in auth — keep the port off the public internet
# (docker network / VPN).
#LLM_PROVIDER=ollama
#LLM_MODEL=qwen2.5:7b
#LLM_BASE_URL=http://<host>:11434/v1

# --- Context ---
# Optional folder with identity.md (memory about the user, loaded by get_context)
MEMORY_HOME=/data/memory

# --- Deploy (read by docker-compose, not by the app) ---
#API_PORT=8400        # the public REST/MCP port
#POSTGRES_PORT=5432   # the DB port published to the host (for tests/CLI)
